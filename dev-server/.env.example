# Copy to .env and adjust. Read by docker-compose.yml and the scripts in scripts/.
#
# This is ONLINE, PC-HOSTED routing for development (DESIGN.md §4.3, §15 Phase 1).
# It is not offline phone support and must not be labelled as such in the app.

# Geofabrik region paths (space-separated, relative to https://download.geofabrik.de/).
# First extract: Mississippi + Louisiana + Alabama ("Gulf South").
HANSEL_REGIONS="north-america/us/mississippi north-america/us/louisiana north-america/us/alabama"

# Name of the merged PBF written to data/osm/ and read by all three services.
HANSEL_PBF=gulf-south.osm.pbf

# Host ports. These are the three base URLs the app's Settings screen needs:
#   Valhalla     http://<pc-ip>:${VALHALLA_PORT}
#   GraphHopper  http://<pc-ip>:${GRAPHHOPPER_PORT}
#   Nominatim    http://<pc-ip>:${NOMINATIM_PORT}
VALHALLA_PORT=8002
GRAPHHOPPER_PORT=8989
NOMINATIM_PORT=8080

# Valhalla: threads used for tile building and serving (default: nproc). Lower it if the build OOMs.
VALHALLA_THREADS=4

# GraphHopper JVM heap. Import with CH+LM+turn costs for ~350 MB of PBF comfortably fits in 4 GB.
GRAPHHOPPER_JAVA_OPTS=-Xmx4g -Xms1g

# Nominatim: import threads and Postgres tuning for a ~16 GB desktop.
# The image defaults (maintenance_work_mem 10GB, effective_cache_size 24GB) assume a large server.
NOMINATIM_THREADS=4
NOMINATIM_POSTGRES_SHARED_BUFFERS=2GB
NOMINATIM_POSTGRES_MAINTENANCE_WORK_MEM=4GB
NOMINATIM_POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
NOMINATIM_PASSWORD=hansel-dev-only
